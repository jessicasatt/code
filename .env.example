# Copy this file to .env.local for local development. Never commit .env.local.
# In production (Vercel), set these as encrypted Environment Variables in the
# project dashboard — never paste real values into chat, code, or git history.

# ---------------------------------------------------------------------------
# Supabase (leave unset to run in demo mode with fictional data)
# ---------------------------------------------------------------------------
# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings -> API -> Project API keys -> anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings -> API -> Project API keys -> service_role (SERVER-ONLY, never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# HighLevel (development mode: Private Integration Token + Location ID)
# ---------------------------------------------------------------------------
HIGHLEVEL_PRIVATE_INTEGRATION_TOKEN=
HIGHLEVEL_LOCATION_ID=
# Only set this if/when HighLevel's webhook delivery for your account supports
# a verifiable signature. See HIGHLEVEL_INTEGRATION.md for what is and isn't
# verified today.
HIGHLEVEL_WEBHOOK_SHARED_SECRET=

# ---------------------------------------------------------------------------
# Web Push (VAPID) — generate with `npm run generate:vapid`
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact URI HighLevel/push services can use to reach you about this
# application, e.g. mailto:you@example.com
VAPID_SUBJECT=

# ---------------------------------------------------------------------------
# Optional AI coaching layer (Milestone 5). App is fully usable without this.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Scheduler / cron authentication
# ---------------------------------------------------------------------------
# Shared secret the scheduled-job endpoints require in an Authorization header,
# so they can't be triggered by anyone who guesses the URL.
CRON_SECRET=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
